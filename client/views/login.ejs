<div class="overlay" id="loginOverlay">
  <div class="modal">
    <h2>Admin log in</h2>
    <div class="modal-sub">demo credentials — admin / admin123</div>
    <div class="modal-error" id="loginError">Incorrect username or password.</div>
    <div class="field">
      <label>Username</label>
      <input type="text" id="loginUser" placeholder="admin">
    </div>
    <div class="field">
      <label>Password</label>
      <input type="password" id="loginPass" placeholder="••••••••">
    </div>
    <div class="modal-actions">
      <button class="btn btn-line" id="loginCancelBtn">Cancel</button>
      <button class="btn btn-navy" id="loginSubmitBtn">Log in</button>
    </div>
  </div>
</div>
